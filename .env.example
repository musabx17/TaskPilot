# Google Gemini API Key (Optional: leave empty for 100% deterministic local fallback)
# Get your free key at: https://aistudio.google.com/app/apikey
# The app works offline without a key — AI features are optional.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Application and Persistence Settings
DATABASE_PATH=taskpilot.db
LOG_LEVEL=INFO
