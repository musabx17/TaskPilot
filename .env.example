# Google Gemini API Key (Optional: leave empty for 100% deterministic local fallback)
# Note: Google Gemini Free Tier has quotas (15 RPM / 1,500 RPD for gemini-2.5-flash).
# The app automatically catches rate limits, timeouts, and network issues and falls back to deterministic logic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Application and Persistence Settings
DATABASE_PATH=taskpilot.db
LOG_LEVEL=INFO
